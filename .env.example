NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
COMUN_BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=
SUPABASE_PROJECT_ID=
COMUN_LOOKUP_HASH_SALT=

# Provedor de armazenamento de midia. Valores aceitos:
# - supabase-local: buckets do Supabase local; usar em desenvolvimento/testes locais.
# - fixture: provider em memoria; SOMENTE onde o contrato de teste permitir
#   (proibido em producao; a aplicacao recusa essa combinacao).
# - r2: Cloudflare R2 real; NUNCA usar em testes locais.
# Padrao quando ausente: "fixture" em NODE_ENV=test, "r2" nos demais ambientes.
# Valores fora da lista sao recusados pela aplicacao.
MEDIA_STORAGE_PROVIDER=

R2_ACCOUNT_ID=
# Token S3 do R2 com acesso apenas aos dois buckets do acervo.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Formato: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Originais privados; nunca expor por dominio publico.
R2_BUCKET_ORIGINALS=
# Derivados aprovados para publicacao.
R2_BUCKET_PUBLIC=
# Dominio publico do bucket de derivados, sem barra final.
# Obrigatoria para servir derivadas publicas quando MEDIA_STORAGE_PROVIDER=r2;
# sem ela a geracao de URL publica falha. Nao apontar para R2 real em testes.
R2_PUBLIC_BASE_URL=
